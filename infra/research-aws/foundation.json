{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Bakata INT-18G: dormant research foundation, optional fixture-only private Fargate definition. No provider calls, schedules or services.",
  "Parameters": {
    "EnableFixtureNetwork": {
      "Type": "String",
      "AllowedValues": [
        "false",
        "true"
      ],
      "Default": "false",
      "Description": "Opt-in to billable private endpoints and fixture task definition; never launches a task."
    },
    "WorkerImageDigest": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^sha256:[0-9a-f]{64}$",
      "Description": "Reviewed fixture image already mirrored to stack worker ECR repository."
    },
    "DatabaseImageDigest": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^sha256:[0-9a-f]{64}$",
      "Description": "Reviewed MariaDB image already mirrored to stack DB ECR repository."
    },
    "EnableFixturePersistence": {
      "Type": "String",
      "AllowedValues": [
        "false",
        "true"
      ],
      "Default": "false",
      "Description": "Opt-in persistent synthetic task definition only; no task launch."
    },
    "CoordinatorImageDigest": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^sha256:[0-9a-f]{64}$"
    },
    "EnableProxyFixture": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "false",
        "true"
      ],
      "Description": "Private synthetic proxy network only; no tasks or Internet route"
    },
    "S3ManagedPrefixList": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^pl-[0-9a-f]{8,17}$",
      "Description": "Reviewed AWS regional service managed prefix list ID"
    },
    "DynamoManagedPrefixList": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^pl-[0-9a-f]{8,17}$",
      "Description": "Reviewed AWS regional service managed prefix list ID"
    }
  },
  "Rules": {
    "ImagesRequired": {
      "RuleCondition": {
        "Fn::Equals": [
          {
            "Ref": "EnableFixtureNetwork"
          },
          "true"
        ]
      },
      "Assertions": [
        {
          "Assert": {
            "Fn::And": [
              {
                "Fn::Not": [
                  {
                    "Fn::Equals": [
                      {
                        "Ref": "WorkerImageDigest"
                      },
                      ""
                    ]
                  }
                ]
              },
              {
                "Fn::Not": [
                  {
                    "Fn::Equals": [
                      {
                        "Ref": "DatabaseImageDigest"
                      },
                      ""
                    ]
                  }
                ]
              }
            ]
          },
          "AssertDescription": "Both reviewed image digests are required for fixture networking."
        }
      ]
    },
    "PersistenceRequiresNetwork": {
      "RuleCondition": {
        "Fn::Equals": [
          {
            "Ref": "EnableFixturePersistence"
          },
          "true"
        ]
      },
      "Assertions": [
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "EnableFixtureNetwork"
              },
              "true"
            ]
          },
          "AssertDescription": "Private fixture network is required."
        },
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Equals": [
                  {
                    "Ref": "CoordinatorImageDigest"
                  },
                  ""
                ]
              }
            ]
          },
          "AssertDescription": "Reviewed coordinator digest required."
        }
      ]
    },
    "ProxyRequiresPersistence": {
      "RuleCondition": {
        "Fn::Equals": [
          {
            "Ref": "EnableProxyFixture"
          },
          "true"
        ]
      },
      "Assertions": [
        {
          "Assert": {
            "Fn::And": [
              {
                "Fn::Equals": [
                  {
                    "Ref": "EnableFixtureNetwork"
                  },
                  "true"
                ]
              },
              {
                "Fn::Equals": [
                  {
                    "Ref": "EnableFixturePersistence"
                  },
                  "true"
                ]
              }
            ]
          },
          "AssertDescription": "Persistent private fixture network required"
        },
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Equals": [
                  {
                    "Ref": "S3ManagedPrefixList"
                  },
                  ""
                ]
              }
            ]
          },
          "AssertDescription": "Explicit reviewed S3ManagedPrefixList required"
        },
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Equals": [
                  {
                    "Ref": "DynamoManagedPrefixList"
                  },
                  ""
                ]
              }
            ]
          },
          "AssertDescription": "Explicit reviewed DynamoManagedPrefixList required"
        }
      ]
    }
  },
  "Conditions": {
    "FixtureNetworkEnabled": {
      "Fn::Equals": [
        {
          "Ref": "EnableFixtureNetwork"
        },
        "true"
      ]
    },
    "PersistentFixtureEnabled": {
      "Fn::And": [
        {
          "Condition": "FixtureNetworkEnabled"
        },
        {
          "Fn::Equals": [
            {
              "Ref": "EnableFixturePersistence"
            },
            "true"
          ]
        }
      ]
    },
    "ProxyFixtureEnabled": {
      "Fn::And": [
        {
          "Condition": "PersistentFixtureEnabled"
        },
        {
          "Fn::Equals": [
            {
              "Ref": "EnableProxyFixture"
            },
            "true"
          ]
        }
      ]
    }
  },
  "Resources": {
    "WorkerRepository": {
      "Type": "AWS::ECR::Repository",
      "Properties": {
        "ImageTagMutability": "IMMUTABLE",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        },
        "EncryptionConfiguration": {
          "EncryptionType": "AES256"
        },
        "EmptyOnDelete": false
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "DatabaseRepository": {
      "Type": "AWS::ECR::Repository",
      "Properties": {
        "ImageTagMutability": "IMMUTABLE",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        },
        "EncryptionConfiguration": {
          "EncryptionType": "AES256"
        },
        "EmptyOnDelete": false
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "EvidenceBucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "AbortIncompleteUploads",
              "Status": "Enabled",
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 7
              }
            }
          ]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "EvidencePolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "EvidenceBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "EvidenceBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${EvidenceBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "CaptureLedger": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "pk",
            "AttributeType": "S"
          },
          {
            "AttributeName": "sk",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "pk",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "sk",
            "KeyType": "RANGE"
          }
        ],
        "SSESpecification": {
          "SSEEnabled": true
        },
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        },
        "DeletionProtectionEnabled": true
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "ResearchCluster": {
      "Type": "AWS::ECS::Cluster",
      "Properties": {
        "ClusterSettings": [
          {
            "Name": "containerInsights",
            "Value": "disabled"
          }
        ]
      }
    },
    "CoordinatorLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}-coordinator"
        },
        "RetentionInDays": 14
      }
    },
    "CoordinatorRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "OwnLogsOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/${AWS::StackName}-coordinator:log-stream:*"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Coordinator": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-coordinator"
        },
        "Role": {
          "Fn::GetAtt": [
            "CoordinatorRole",
            "Arn"
          ]
        },
        "Runtime": "python3.12",
        "Handler": "index.handler",
        "Timeout": 5,
        "MemorySize": 128,
        "ReservedConcurrentExecutions": 0,
        "Code": {
          "ZipFile": "def handler(event, context):\n    return {'state': 'disabled', 'provider_queries': 0}\n"
        }
      },
      "DependsOn": "CoordinatorLogs"
    },
    "ResearchVpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.211.0.0/24",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true
      },
      "Condition": "FixtureNetworkEnabled"
    },
    "ResearchSubnet": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "ResearchVpc"
        },
        "CidrBlock": "10.211.0.0/26",
        "MapPublicIpOnLaunch": false
      },
      "Condition": "FixtureNetworkEnabled"
    },
    "ResearchRoutes": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "ResearchVpc"
        }
      },
      "Condition": "FixtureNetworkEnabled"
    },
    "SubnetRoutes": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "ResearchSubnet"
        },
        "RouteTableId": {
          "Ref": "ResearchRoutes"
        }
      },
      "Condition": "FixtureNetworkEnabled"
    },
    "WorkerSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Fixture task: no ingress, TLS egress in isolated VPC",
        "VpcId": {
          "Ref": "ResearchVpc"
        },
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          }
        ]
      },
      "Condition": "FixtureNetworkEnabled"
    },
    "EndpointSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Private AWS endpoints, fixture task only",
        "VpcId": {
          "Ref": "ResearchVpc"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "SourceSecurityGroupId": {
              "Ref": "WorkerSecurityGroup"
            }
          }
        ]
      },
      "Condition": "FixtureNetworkEnabled"
    },
    "S3Endpoint": {
      "Type": "AWS::EC2::VPCEndpoint",
      "Properties": {
        "VpcId": {
          "Ref": "ResearchVpc"
        },
        "VpcEndpointType": "Gateway",
        "ServiceName": {
          "Fn::Sub": "com.amazonaws.${AWS::Region}.s3"
        },
        "RouteTableIds": [
          {
            "Ref": "ResearchRoutes"
          },
          {
            "Fn::If": [
              "ProxyFixtureEnabled",
              {
                "Ref": "ProxyFixtureRoutes"
              },
              {
                "Ref": "AWS::NoValue"
              }
            ]
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": "*",
              "Action": "s3:GetObject",
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::prod-${AWS::Region}-starport-layer-bucket/*"
              }
            },
            {
              "Fn::If": [
                "PersistentFixtureEnabled",
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:GetObjectVersion"
                  ],
                  "Resource": {
                    "Fn::Sub": "${EvidenceBucket.Arn}/fixture-research/v1/7/*"
                  },
                  "Principal": "*",
                  "Condition": {
                    "ArnEquals": {
                      "aws:PrincipalArn": {
                        "Fn::GetAtt": [
                          "FixtureTaskRole",
                          "Arn"
                        ]
                      }
                    }
                  }
                },
                {
                  "Ref": "AWS::NoValue"
                }
              ]
            },
            {
              "Fn::If": [
                "PersistentFixtureEnabled",
                {
                  "Effect": "Allow",
                  "Action": "s3:PutObject",
                  "Resource": {
                    "Fn::Sub": "${EvidenceBucket.Arn}/fixture-research/v1/7/*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "s3:if-none-match": "*",
                      "s3:x-amz-server-side-encryption": "AES256"
                    },
                    "ArnEquals": {
                      "aws:PrincipalArn": {
                        "Fn::GetAtt": [
                          "FixtureTaskRole",
                          "Arn"
                        ]
                      }
                    }
                  },
                  "Principal": "*"
                },
                {
                  "Ref": "AWS::NoValue"
                }
              ]
            }
          ]
        }
      },
      "Condition": "FixtureNetworkEnabled"
    },
    "WorkerLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "RetentionInDays": 7
      },
      "Condition": "FixtureNetworkEnabled"
    },
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "PullReviewedImagesAndOwnLogs",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "ecr:GetAuthorizationToken",
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchGetImage"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "WorkerRepository",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::GetAtt": [
                        "DatabaseRepository",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::GetAtt": [
                        "CoordinatorRepository",
                        "Arn"
                      ]
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:${WorkerLogs}:log-stream:*"
                  }
                }
              ]
            }
          }
        ]
      },
      "Condition": "FixtureNetworkEnabled"
    },
    "EcrApiEndpoint": {
      "Type": "AWS::EC2::VPCEndpoint",
      "Properties": {
        "VpcId": {
          "Ref": "ResearchVpc"
        },
        "VpcEndpointType": "Interface",
        "ServiceName": {
          "Fn::Sub": "com.amazonaws.${AWS::Region}.ecr.api"
        },
        "SubnetIds": [
          {
            "Ref": "ResearchSubnet"
          }
        ],
        "SecurityGroupIds": [
          {
            "Ref": "EndpointSecurityGroup"
          }
        ],
        "PrivateDnsEnabled": true
      },
      "Condition": "FixtureNetworkEnabled"
    },
    "EcrDockerEndpoint": {
      "Type": "AWS::EC2::VPCEndpoint",
      "Properties": {
        "VpcId": {
          "Ref": "ResearchVpc"
        },
        "VpcEndpointType": "Interface",
        "ServiceName": {
          "Fn::Sub": "com.amazonaws.${AWS::Region}.ecr.dkr"
        },
        "SubnetIds": [
          {
            "Ref": "ResearchSubnet"
          }
        ],
        "SecurityGroupIds": [
          {
            "Ref": "EndpointSecurityGroup"
          }
        ],
        "PrivateDnsEnabled": true
      },
      "Condition": "FixtureNetworkEnabled"
    },
    "LogsEndpoint": {
      "Type": "AWS::EC2::VPCEndpoint",
      "Properties": {
        "VpcId": {
          "Ref": "ResearchVpc"
        },
        "VpcEndpointType": "Interface",
        "ServiceName": {
          "Fn::Sub": "com.amazonaws.${AWS::Region}.logs"
        },
        "SubnetIds": [
          {
            "Ref": "ResearchSubnet"
          }
        ],
        "SecurityGroupIds": [
          {
            "Ref": "EndpointSecurityGroup"
          }
        ],
        "PrivateDnsEnabled": true
      },
      "Condition": "FixtureNetworkEnabled"
    },
    "FixtureTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": {
          "Fn::Sub": "${AWS::StackName}-fixture"
        },
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "NetworkMode": "awsvpc",
        "Cpu": "1024",
        "Memory": "2048",
        "RuntimePlatform": {
          "CpuArchitecture": "X86_64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "EphemeralStorage": {
          "SizeInGiB": 21
        },
        "Volumes": [
          {
            "Name": "scratch"
          },
          {
            "Name": "database"
          }
        ],
        "ContainerDefinitions": [
          {
            "Name": "database",
            "Image": {
              "Fn::Sub": "${DatabaseRepository.RepositoryUri}@${DatabaseImageDigest}"
            },
            "Essential": true,
            "Cpu": 256,
            "Memory": 512,
            "Environment": [
              {
                "Name": "MARIADB_DATABASE",
                "Value": "fixture"
              },
              {
                "Name": "MARIADB_USER",
                "Value": "fixture"
              },
              {
                "Name": "MARIADB_PASSWORD",
                "Value": "ci-research-only"
              },
              {
                "Name": "MARIADB_ROOT_PASSWORD",
                "Value": "ci-research-root-only"
              }
            ],
            "MountPoints": [
              {
                "SourceVolume": "database",
                "ContainerPath": "/var/lib/mysql",
                "ReadOnly": false
              }
            ],
            "HealthCheck": {
              "Command": [
                "CMD-SHELL",
                "healthcheck.sh --connect --innodb_initialized"
              ],
              "Interval": 10,
              "Timeout": 5,
              "Retries": 6,
              "StartPeriod": 30
            },
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "WorkerLogs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "db"
              }
            }
          },
          {
            "Name": "worker",
            "Image": {
              "Fn::Sub": "${WorkerRepository.RepositoryUri}@${WorkerImageDigest}"
            },
            "Essential": true,
            "Cpu": 768,
            "Memory": 768,
            "User": "33:33",
            "ReadonlyRootFilesystem": true,
            "LinuxParameters": {
              "Capabilities": {
                "Drop": [
                  "ALL"
                ]
              }
            },
            "DependsOn": [
              {
                "ContainerName": "database",
                "Condition": "HEALTHY"
              }
            ],
            "Environment": [
              {
                "Name": "BAKATA_RESEARCH_FIXTURE",
                "Value": "1"
              }
            ],
            "MountPoints": [
              {
                "SourceVolume": "scratch",
                "ContainerPath": "/tmp",
                "ReadOnly": false
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "WorkerLogs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "fixture"
              }
            }
          }
        ]
      },
      "Condition": "FixtureNetworkEnabled"
    },
    "CoordinatorRepository": {
      "Type": "AWS::ECR::Repository",
      "Properties": {
        "ImageTagMutability": "IMMUTABLE",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        },
        "EncryptionConfiguration": {
          "EncryptionType": "AES256"
        },
        "EmptyOnDelete": false
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "FixtureTaskRole": {
      "Type": "AWS::IAM::Role",
      "Condition": "PersistentFixtureEnabled",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:ecs:${AWS::Region}:${AWS::AccountId}:*"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "FixturePartitionAndObjects",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:ConditionCheckItem"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "CaptureLedger",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "ForAllValues:StringEquals": {
                      "dynamodb:LeadingKeys": [
                        "FIXTURE#STORE#7"
                      ]
                    },
                    "Null": {
                      "dynamodb:LeadingKeys": "false"
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:GetObjectVersion"
                  ],
                  "Resource": {
                    "Fn::Sub": "${EvidenceBucket.Arn}/fixture-research/v1/7/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "s3:PutObject",
                  "Resource": {
                    "Fn::Sub": "${EvidenceBucket.Arn}/fixture-research/v1/7/*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "s3:if-none-match": "*",
                      "s3:x-amz-server-side-encryption": "AES256"
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "DynamoEndpoint": {
      "Type": "AWS::EC2::VPCEndpoint",
      "Condition": "PersistentFixtureEnabled",
      "Properties": {
        "VpcId": {
          "Ref": "ResearchVpc"
        },
        "VpcEndpointType": "Gateway",
        "ServiceName": {
          "Fn::Sub": "com.amazonaws.${AWS::Region}.dynamodb"
        },
        "RouteTableIds": [
          {
            "Ref": "ResearchRoutes"
          },
          {
            "Fn::If": [
              "ProxyFixtureEnabled",
              {
                "Ref": "ProxyFixtureRoutes"
              },
              {
                "Ref": "AWS::NoValue"
              }
            ]
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "dynamodb:GetItem",
                "dynamodb:PutItem",
                "dynamodb:ConditionCheckItem"
              ],
              "Resource": {
                "Fn::GetAtt": [
                  "CaptureLedger",
                  "Arn"
                ]
              },
              "Condition": {
                "ForAllValues:StringEquals": {
                  "dynamodb:LeadingKeys": [
                    "FIXTURE#STORE#7"
                  ]
                },
                "Null": {
                  "dynamodb:LeadingKeys": "false"
                },
                "ArnEquals": {
                  "aws:PrincipalArn": {
                    "Fn::GetAtt": [
                      "FixtureTaskRole",
                      "Arn"
                    ]
                  }
                }
              },
              "Principal": "*"
            }
          ]
        }
      }
    },
    "PersistentFixtureTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Condition": "PersistentFixtureEnabled",
      "Properties": {
        "Family": {
          "Fn::Sub": "${AWS::StackName}-persistent-fixture"
        },
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "NetworkMode": "awsvpc",
        "Cpu": "1024",
        "Memory": "2048",
        "RuntimePlatform": {
          "CpuArchitecture": "X86_64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "EphemeralStorage": {
          "SizeInGiB": 21
        },
        "Volumes": [
          {
            "Name": "scratch"
          },
          {
            "Name": "database"
          },
          {
            "Name": "exchange"
          }
        ],
        "ContainerDefinitions": [
          {
            "Name": "database",
            "Image": {
              "Fn::Sub": "${DatabaseRepository.RepositoryUri}@${DatabaseImageDigest}"
            },
            "Essential": true,
            "Cpu": 256,
            "Memory": 512,
            "Environment": [
              {
                "Name": "MARIADB_DATABASE",
                "Value": "fixture"
              },
              {
                "Name": "MARIADB_USER",
                "Value": "fixture"
              },
              {
                "Name": "MARIADB_PASSWORD",
                "Value": "ci-research-only"
              },
              {
                "Name": "MARIADB_ROOT_PASSWORD",
                "Value": "ci-research-root-only"
              }
            ],
            "MountPoints": [
              {
                "SourceVolume": "database",
                "ContainerPath": "/var/lib/mysql",
                "ReadOnly": false
              }
            ],
            "HealthCheck": {
              "Command": [
                "CMD-SHELL",
                "healthcheck.sh --connect --innodb_initialized"
              ],
              "Interval": 10,
              "Timeout": 5,
              "Retries": 6,
              "StartPeriod": 30
            },
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "WorkerLogs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "db"
              }
            }
          },
          {
            "Name": "worker",
            "Image": {
              "Fn::Sub": "${WorkerRepository.RepositoryUri}@${WorkerImageDigest}"
            },
            "Essential": false,
            "Cpu": 512,
            "Memory": 768,
            "User": "33:33",
            "ReadonlyRootFilesystem": true,
            "LinuxParameters": {
              "Capabilities": {
                "Drop": [
                  "ALL"
                ]
              }
            },
            "DependsOn": [
              {
                "ContainerName": "database",
                "Condition": "HEALTHY"
              }
            ],
            "Environment": [
              {
                "Name": "BAKATA_RESEARCH_FIXTURE",
                "Value": "1"
              },
              {
                "Name": "BAKATA_RESEARCH_PERSIST",
                "Value": "1"
              }
            ],
            "MountPoints": [
              {
                "SourceVolume": "scratch",
                "ContainerPath": "/tmp",
                "ReadOnly": false
              },
              {
                "SourceVolume": "exchange",
                "ContainerPath": "/exchange",
                "ReadOnly": false
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "WorkerLogs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "fixture"
              }
            }
          },
          {
            "Name": "coordinator",
            "Image": {
              "Fn::Sub": "${CoordinatorRepository.RepositoryUri}@${CoordinatorImageDigest}"
            },
            "Essential": true,
            "Cpu": 256,
            "Memory": 512,
            "User": "33:33",
            "ReadonlyRootFilesystem": true,
            "LinuxParameters": {
              "Capabilities": {
                "Drop": [
                  "ALL"
                ]
              }
            },
            "DependsOn": [
              {
                "ContainerName": "worker",
                "Condition": "START"
              }
            ],
            "Environment": [
              {
                "Name": "BAKATA_RESEARCH_FIXTURE",
                "Value": "1"
              },
              {
                "Name": "BAKATA_RESEARCH_PERSIST",
                "Value": "1"
              },
              {
                "Name": "BAKATA_LEDGER",
                "Value": {
                  "Ref": "CaptureLedger"
                }
              },
              {
                "Name": "BAKATA_EVIDENCE_BUCKET",
                "Value": {
                  "Ref": "EvidenceBucket"
                }
              },
              {
                "Name": "AWS_REGION",
                "Value": {
                  "Ref": "AWS::Region"
                }
              }
            ],
            "MountPoints": [
              {
                "SourceVolume": "exchange",
                "ContainerPath": "/exchange",
                "ReadOnly": false
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "WorkerLogs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "coordinator"
              }
            }
          }
        ],
        "TaskRoleArn": {
          "Fn::GetAtt": [
            "FixtureTaskRole",
            "Arn"
          ]
        }
      }
    },
    "ProxyFixtureWorkerSubnet": {
      "Type": "AWS::EC2::Subnet",
      "Condition": "ProxyFixtureEnabled",
      "Properties": {
        "VpcId": {
          "Ref": "ResearchVpc"
        },
        "CidrBlock": "10.211.0.64/26",
        "AvailabilityZone": {
          "Fn::GetAtt": [
            "ResearchSubnet",
            "AvailabilityZone"
          ]
        },
        "MapPublicIpOnLaunch": false
      }
    },
    "ProxyFixtureWorkerSubnetAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Condition": "ProxyFixtureEnabled",
      "Properties": {
        "SubnetId": {
          "Ref": "ProxyFixtureWorkerSubnet"
        },
        "RouteTableId": {
          "Ref": "ProxyFixtureRoutes"
        }
      }
    },
    "ProxyFixtureSubnet": {
      "Type": "AWS::EC2::Subnet",
      "Condition": "ProxyFixtureEnabled",
      "Properties": {
        "VpcId": {
          "Ref": "ResearchVpc"
        },
        "CidrBlock": "10.211.0.128/26",
        "AvailabilityZone": {
          "Fn::GetAtt": [
            "ResearchSubnet",
            "AvailabilityZone"
          ]
        },
        "MapPublicIpOnLaunch": false
      }
    },
    "ProxyFixtureSubnetAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Condition": "ProxyFixtureEnabled",
      "Properties": {
        "SubnetId": {
          "Ref": "ProxyFixtureSubnet"
        },
        "RouteTableId": {
          "Ref": "ProxyFixtureRoutes"
        }
      }
    },
    "ProxyFixtureRoutes": {
      "Type": "AWS::EC2::RouteTable",
      "Condition": "ProxyFixtureEnabled",
      "Properties": {
        "VpcId": {
          "Ref": "ResearchVpc"
        }
      }
    },
    "ProxyFixtureSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Condition": "ProxyFixtureEnabled",
      "Properties": {
        "VpcId": {
          "Ref": "ResearchVpc"
        },
        "GroupDescription": "Synthetic proxy: AWS image and logs endpoints only; no Internet",
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "DestinationSecurityGroupId": {
              "Ref": "EndpointSecurityGroup"
            }
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "DestinationPrefixListId": {
              "Ref": "S3ManagedPrefixList"
            }
          }
        ]
      }
    },
    "ProxyFixtureWorkerSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Condition": "ProxyFixtureEnabled",
      "Properties": {
        "VpcId": {
          "Ref": "ResearchVpc"
        },
        "GroupDescription": "Worker: approved AWS endpoints and authenticated fixture proxy only",
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "DestinationSecurityGroupId": {
              "Ref": "EndpointSecurityGroup"
            }
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "DestinationPrefixListId": {
              "Ref": "S3ManagedPrefixList"
            }
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "DestinationPrefixListId": {
              "Ref": "DynamoManagedPrefixList"
            }
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 8443,
            "ToPort": 8443,
            "DestinationSecurityGroupId": {
              "Ref": "ProxyFixtureSecurityGroup"
            }
          }
        ]
      }
    },
    "ProxyFixtureIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Condition": "ProxyFixtureEnabled",
      "Properties": {
        "GroupId": {
          "Ref": "ProxyFixtureSecurityGroup"
        },
        "SourceSecurityGroupId": {
          "Ref": "ProxyFixtureWorkerSecurityGroup"
        },
        "IpProtocol": "tcp",
        "FromPort": 8443,
        "ToPort": 8443
      }
    },
    "ProxyFixtureEndpointIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Condition": "ProxyFixtureEnabled",
      "Properties": {
        "GroupId": {
          "Ref": "EndpointSecurityGroup"
        },
        "SourceSecurityGroupId": {
          "Ref": "ProxyFixtureSecurityGroup"
        },
        "IpProtocol": "tcp",
        "FromPort": 443,
        "ToPort": 443
      }
    },
    "ProxyFixtureWorkerEndpointIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Condition": "ProxyFixtureEnabled",
      "Properties": {
        "GroupId": {
          "Ref": "EndpointSecurityGroup"
        },
        "SourceSecurityGroupId": {
          "Ref": "ProxyFixtureWorkerSecurityGroup"
        },
        "IpProtocol": "tcp",
        "FromPort": 443,
        "ToPort": 443
      }
    }
  },
  "Outputs": {
    "WorkerRepositoryUri": {
      "Value": {
        "Fn::GetAtt": [
          "WorkerRepository",
          "RepositoryUri"
        ]
      }
    },
    "DatabaseRepositoryUri": {
      "Value": {
        "Fn::GetAtt": [
          "DatabaseRepository",
          "RepositoryUri"
        ]
      }
    },
    "EvidenceBucketName": {
      "Value": {
        "Ref": "EvidenceBucket"
      }
    },
    "LedgerName": {
      "Value": {
        "Ref": "CaptureLedger"
      }
    },
    "ClusterName": {
      "Value": {
        "Ref": "ResearchCluster"
      }
    },
    "FixtureTaskArn": {
      "Condition": "FixtureNetworkEnabled",
      "Value": {
        "Ref": "FixtureTask"
      }
    },
    "FixtureSubnet": {
      "Condition": "FixtureNetworkEnabled",
      "Value": {
        "Ref": "ResearchSubnet"
      }
    },
    "FixtureSecurityGroup": {
      "Condition": "FixtureNetworkEnabled",
      "Value": {
        "Ref": "WorkerSecurityGroup"
      }
    },
    "CoordinatorRepositoryUri": {
      "Value": {
        "Fn::GetAtt": [
          "CoordinatorRepository",
          "RepositoryUri"
        ]
      }
    },
    "PersistentFixtureTaskArn": {
      "Condition": "PersistentFixtureEnabled",
      "Value": {
        "Ref": "PersistentFixtureTask"
      }
    },
    "ProxyFixtureWorkerSubnet": {
      "Condition": "ProxyFixtureEnabled",
      "Value": {
        "Ref": "ProxyFixtureWorkerSubnet"
      }
    },
    "ProxyFixtureSubnet": {
      "Condition": "ProxyFixtureEnabled",
      "Value": {
        "Ref": "ProxyFixtureSubnet"
      }
    },
    "ProxyFixtureWorkerSecurityGroup": {
      "Condition": "ProxyFixtureEnabled",
      "Value": {
        "Ref": "ProxyFixtureWorkerSecurityGroup"
      }
    },
    "ProxyFixtureSecurityGroup": {
      "Condition": "ProxyFixtureEnabled",
      "Value": {
        "Ref": "ProxyFixtureSecurityGroup"
      }
    }
  }
}
