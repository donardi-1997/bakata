{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Fixture-only proxy task registration; no service, task launch, credentials or network resources.",
  "Parameters": {
    "EnableProxyRepository": {"Type": "String", "Default": "false", "AllowedValues": ["true", "false"]},
    "EnableProxyTask": {"Type": "String", "Default": "false", "AllowedValues": ["true", "false"]},
    "ProxyImageDigest": {"Type": "String", "Default": "", "AllowedPattern": "^$|^sha256:[a-f0-9]{64}$"}
  },
  "Rules": {
    "DigestRequired": {
      "RuleCondition": {"Fn::Equals": [{"Ref": "EnableProxyTask"}, "true"]},
      "Assertions": [
        {"Assert": {"Fn::Not": [{"Fn::Equals": [{"Ref": "ProxyImageDigest"}, ""]}]}, "AssertDescription": "A reviewed fixture image digest is required."},
        {"Assert": {"Fn::Equals": [{"Ref": "EnableProxyRepository"}, "true"]}, "AssertDescription": "Enable the proxy repository before registering its task."}
      ]
    }
  },
  "Conditions": {
    "ProxyTaskEnabled": {"Fn::Equals": [{"Ref": "EnableProxyTask"}, "true"]},
    "ProxyRepositoryEnabled": {"Fn::Or": [{"Fn::Equals": [{"Ref": "EnableProxyRepository"}, "true"]}, {"Condition": "ProxyTaskEnabled"}]}
  },
  "Resources": {
    "ProxyRepository": {
      "Type": "AWS::ECR::Repository",
      "Condition": "ProxyRepositoryEnabled",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {"ImageTagMutability": "IMMUTABLE", "ImageScanningConfiguration": {"ScanOnPush": true}, "EncryptionConfiguration": {"EncryptionType": "AES256"}}
    },
    "ProxyLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Condition": "ProxyTaskEnabled",
      "Properties": {"RetentionInDays": 7}
    },
    "ProxyExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Condition": "ProxyTaskEnabled",
      "Properties": {
        "AssumeRolePolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"Service": "ecs-tasks.amazonaws.com"}, "Action": "sts:AssumeRole"}]},
        "Policies": [{"PolicyName": "PullProxyAndWriteOwnLogs", "PolicyDocument": {"Version": "2012-10-17", "Statement": [
          {"Effect": "Allow", "Action": "ecr:GetAuthorizationToken", "Resource": "*"},
          {"Effect": "Allow", "Action": ["ecr:BatchCheckLayerAvailability", "ecr:GetDownloadUrlForLayer", "ecr:BatchGetImage"], "Resource": {"Fn::GetAtt": ["ProxyRepository", "Arn"]}},
          {"Effect": "Allow", "Action": ["logs:CreateLogStream", "logs:PutLogEvents"], "Resource": {"Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:${ProxyLogs}:log-stream:*"}}
        ]}}]
      }
    },
    "ProxyTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Condition": "ProxyTaskEnabled",
      "Properties": {
        "Family": {"Fn::Sub": "${AWS::StackName}-proxy-fixture"},
        "RequiresCompatibilities": ["FARGATE"], "NetworkMode": "awsvpc", "Cpu": "256", "Memory": "512",
        "RuntimePlatform": {"CpuArchitecture": "X86_64", "OperatingSystemFamily": "LINUX"},
        "ExecutionRoleArn": {"Fn::GetAtt": ["ProxyExecutionRole", "Arn"]},
        "ContainerDefinitions": [{
          "Name": "proxy-fixture", "Image": {"Fn::Sub": "${ProxyRepository.RepositoryUri}@${ProxyImageDigest}"},
          "Essential": true, "User": "65534:65534", "ReadonlyRootFilesystem": true,
          "LinuxParameters": {"Capabilities": {"Drop": ["ALL"]}},
          "PortMappings": [{"ContainerPort": 8443, "Protocol": "tcp"}],
          "Environment": [{"Name": "BAKATA_RESEARCH_PROXY_FIXTURE", "Value": "1"}],
          "LogConfiguration": {"LogDriver": "awslogs", "Options": {"awslogs-group": {"Ref": "ProxyLogs"}, "awslogs-region": {"Ref": "AWS::Region"}, "awslogs-stream-prefix": "proxy-fixture"}}
        }]
      }
    }
  },
  "Outputs": {
    "ProxyRepositoryUri": {"Condition": "ProxyRepositoryEnabled", "Value": {"Fn::GetAtt": ["ProxyRepository", "RepositoryUri"]}},
    "ProxyTaskDefinition": {"Condition": "ProxyTaskEnabled", "Value": {"Ref": "ProxyTask"}},
    "ProxyExecutionRoleArn": {"Condition": "ProxyTaskEnabled", "Value": {"Fn::GetAtt": ["ProxyExecutionRole", "Arn"]}}
  }
}
