{
  "version": "1.0.0",
  "brand": "Bakatá",
  "direction": "Raíz contemporánea",
  "color": {
    "background": "#F7F4EE",
    "surface": "#FFFFFF",
    "surfaceMuted": "#E9E1D3",
    "text": "#1E1E1E",
    "textMuted": "#505A54",
    "primary": "#1F3A37",
    "primaryHover": "#142B28",
    "onPrimary": "#F7F4EE",
    "accentDecorative": "#B86842",
    "accentText": "#8C4427",
    "border": "#79796F",
    "focus": "#1F3A37",
    "error": "#A12532",
    "success": "#235B42"
  },
  "spacing": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.5rem",
    "6": "2rem",
    "7": "3rem",
    "8": "4rem"
  },
  "radius": {
    "sm": "0.5rem",
    "md": "0.75rem",
    "lg": "1rem",
    "pill": "999px"
  },
  "typography": {
    "heading": "Plus Jakarta Sans",
    "body": "Inter",
    "activeFallback": "system-ui, sans-serif",
    "size": {
      "small": "0.875rem",
      "body": "1rem",
      "lead": "1.125rem",
      "h3": "1.375rem",
      "h2": "clamp(1.5rem, 3vw, 2.25rem)",
      "h1": "clamp(2rem, 5vw, 4rem)"
    }
  },
  "layout": {
    "wide": "1200px",
    "content": "760px",
    "gutter": "clamp(1rem, 4vw, 3rem)",
    "breakpoints": {
      "tablet": "48rem",
      "desktop": "64rem"
    },
    "minTarget": "44px"
  }
}
