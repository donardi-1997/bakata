      "contentSize": "760px",
      "wideSize": "1200px"
    },
    "color": {
      "palette": [
        {
          "slug": "verde",
          "name": "Verde profundo",
          "color": "#1F3A37"
        },
        {
          "slug": "terracota",
          "name": "Terracota",
          "color": "#B86842"
        },
        {
          "slug": "arena",
          "name": "Arena suave",
          "color": "#E9E1D3"
        },
        {
          "slug": "marfil",
          "name": "Marfil",
          "color": "#F7F4EE"
        },
        {
          "slug": "carbon",
          "name": "Carbón",
          "color": "#1E1E1E"
        },
        {
          "slug": "white",
          "name": "Blanco",
          "color": "#FFFFFF"
        },
        {
          "slug": "ink",
          "name": "Carbón (compatibilidad)",
          "color": "#1E1E1E"
        },
        {
          "slug": "paper",
          "name": "Marfil (compatibilidad)",
          "color": "#F7F4EE"
        },
        {
          "slug": "accent",
          "name": "Verde (compatibilidad)",
          "color": "#1F3A37"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "system",
          "name": "Sistema",
          "fontFamily": "system-ui, sans-serif"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|marfil",
      "text": "var:preset|color|carbon"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|system",
      "fontSize": "1rem",
      "lineHeight": "1.6"
    },
    "spacing": {
      "padding": {
        "left": "clamp(1rem, 4vw, 3rem)",
        "right": "clamp(1rem, 4vw, 3rem)"
      }
    },
    "elements": {
      "button": {
        "color": {
          "background": "var:preset|color|verde",
          "text": "var:preset|color|marfil"
        },
        "border": {
          "radius": "0.4rem"
        },
        "spacing": {
          "padding": {
            "top": "0.8rem",
            "bottom": "0.8rem",
            "left": "1.4rem",
            "right": "1.4rem"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Cabecera",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Pie de página",
      "area": "footer"
    }
  ]
}
